# Local scratch and tooling output — nothing here belongs in Git.
.ecc-cache/
.reports/
node_modules/
*.log
.DS_Store
.env
.env.*
!.env.example

# Application tree (ADR-0006): build output and machine-local state.
# apps/android/.gitignore and apps/ios/.gitignore carry the details;
# these are repo-wide safety nets.
target/
build/
.gradle/
.kotlin/
local.properties
*.iml
.idea/
xcuserdata/
DerivedData/
# Signing material must never be committed (docs/rules/security.md).
*.keystore
*.jks

# Python bytecode from local harness checks (never part of the proof)
__pycache__/
*.pyc
