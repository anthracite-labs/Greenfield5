+import Dispatch
+
+/// Owns the raw native future handle for exactly one async call, for as long as
+/// anything can still reach it.
+///
+/// The Rust runtime hands the foreign side one owned reference
+/// (`Arc::into_raw` in `rust_future_new`), and `rust_future_free` is the only
+/// call that consumes it: `rust_future_poll`, `rust_future_cancel` and
+/// `rust_future_complete` merely borrow it (`with_future`/`with_future_arc` do
+/// `Arc::from_raw` + `mem::forget`). Every borrow that starts after that free is
+/// a use-after-free, and a free issued from inside a native call is worse still,
+/// because the runtime is then still inside `RustFuture::poll` / `wake` /
+/// `store_continuation` with a live `&Arc<RustFuture>` and, on the displacement
+/// path, still writes the new continuation into the future after invoking the
+/// displaced one.
+///
+/// So the handle is not owned by "whoever finishes first". It has exactly one
+/// owner, every actor that can still dereference it holds that owner, and the
+/// free happens once, from `deinit`, on the same serial queue that issues every
+/// poll and cancel for this call - after all of them.
+private final class BoltFFIFutureLifetime: @unchecked Sendable {
+    /// The one owner of the owned reference: nothing else stores a copy of the
+    /// handle, and this is what the deferred free captures.
+    private final class Owner: @unchecked Sendable {
+        let handle: RustFutureHandle?
+        let freeHandle: @Sendable (RustFutureHandle?) -> Void
+
+        init(handle: RustFutureHandle?, freeHandle: @escaping @Sendable (RustFutureHandle?) -> Void) {
+            self.handle = handle
+            self.freeHandle = freeHandle
+        }
+    }
+
+    private let owner: Owner
+    private let queue: DispatchQueue
+
+    var handle: RustFutureHandle? { owner.handle }
+
+    init(handle: RustFutureHandle?, freeHandle: @escaping @Sendable (RustFutureHandle?) -> Void) {
+        self.owner = Owner(handle: handle, freeHandle: freeHandle)
+        self.queue = DispatchQueue(label: "boltffi.async.future")
+    }
+
+    /// Runs one native call on this call's serial queue.
+    ///
+    /// Serialising is what makes the ownership work: the block owns its issuer
+    /// (the poll driver or this lifetime), so the handle cannot be released while
+    /// that native call is in flight, and a re-poll queued from inside a callback
+    /// runs after the callback returns instead of inside the runtime's frame.
+    func perform(_ body: @escaping @Sendable () -> Void) {
+        queue.async(execute: body)
+    }
+
+    deinit {
+        // ARC guarantees exactly one deinit, so there is exactly one free, even
+        // under repeated cancellation and even when a queued re-poll is dropped.
+        // It is enqueued rather than called: a deinit can run on a native thread
+        // inside a callback, and the free must never execute inside a native call
+        // or a callback the runtime makes into this module.
+        let owner = self.owner
+        let queue = self.queue
+        queue.async { owner.freeHandle(owner.handle) }
+    }
+}
