     }
 
+    /// Issues one native poll on the call's serial queue.
+    ///
+    /// The queued block owns the driver, the driver owns the lifetime, and the
+    /// block is released only after the native poll has returned. That single
+    /// fact is what the old runtime was missing: a poll can no longer overlap
+    /// another poll (so this side never displaces the continuation the runtime
+    /// parks for it), and the handle cannot be freed while a poll - or a re-poll
+    /// queued from inside a callback - is still going to run.
     func start() {
-        _ = poll(
-            futureHandle,
-            UInt64(UInt(bitPattern: Unmanaged.passRetained(self).toOpaque())),
-            boltffiAsyncPollCallback
-        )
+        lifetime.perform { [self] in
+            _ = poll(
+                lifetime.handle,
+                UInt64(UInt(bitPattern: Unmanaged.passRetained(self).toOpaque())),
+                boltffiAsyncPollCallback
+            )
+        }
     }
 
     func handle(_ result: Int8) {
         if result == 0 {
             ready()
         } else if canPoll() {
-            _Concurrency.Task { [self] in
-                await _Concurrency.Task.yield()
-                start()
-            }
+            // A wake means "poll again": queue the poll instead of running it
+            // here, so this never re-enters the runtime from its own frame. The
+            // check above is an optimisation, not a safety property - the poll it
+            // queues is safe even if it races cancellation, because the handle is
+            // owned by the lifetime and is still alive.
+            start()
+        }
+    }
+
+    /// Marks the native future cancelled, on the same queue as the polls.
+    func cancel(_ cancelHandle: @escaping @Sendable (RustFutureHandle?) -> Void) {
+        lifetime.perform { [self] in
+            cancelHandle(lifetime.handle)
         }
     }
 }
